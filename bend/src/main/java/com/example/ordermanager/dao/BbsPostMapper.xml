<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.ordermanager.dao.BbsPostMapper">

    <!-- 分页 + 条件（板块ID、标题模糊）查询 -->
    <select id="find" resultType="com.example.ordermanager.entity.BbsPost">
        SELECT * FROM `bbs_post`
        <where>
            <if test="boardId != null and boardId > 0">
                AND board_id = #{boardId}
            </if>
            <if test="title != null and title != ''">
                AND title LIKE CONCAT('%', #{title}, '%')
            </if>
        </where>
        ORDER BY create_time DESC
        LIMIT #{offset}, #{rows}
    </select>

    <!-- 统计总数 -->
    <select id="count" resultType="java.lang.Integer">
        SELECT COUNT(*) FROM bbs_post
        <where>
            <if test="boardId != null and boardId > 0">
                AND board_id = #{boardId}
            </if>
            <if test="title != null and title != ''">
                AND title LIKE CONCAT('%', #{title}, '%')
            </if>
        </where>
    </select>

</mapper>